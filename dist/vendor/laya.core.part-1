            }
            function clear() {
                sound.offAll();
            }
        }
        onProgress(value) {
            if (this._type === Loader.ATLAS)
                this.event(Event.PROGRESS, value * 0.3);
            else if (this._originType == Loader.HIERARCHY)
                this.event(Event.PROGRESS, value / 3);
            else
                this.event(Event.PROGRESS, value);
